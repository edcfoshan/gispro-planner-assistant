<Window x:Class="GisProAddinWorkbench.AddIn.Settings.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="系统设置"
        Width="980"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="12"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Background="#F8FAFC">
      <StackPanel>
        <TextBlock Text="系统设置"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#0F172A" />
        <TextBlock Margin="0,6,0,0"
                   Text="设置已按类型分组：外观设置优先用于实时调整工作台布局，配置设置用于基础配置、前期调研 Key 与在线瓦片服务密钥。"
                   Foreground="#334155"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,10,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Padding="8"
              CornerRadius="12"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              Background="#FFFFFF">
        <ListBox ItemsSource="{Binding CategoryOptions}"
                 SelectedItem="{Binding SelectedCategoryOption}"
                 BorderThickness="0"
                 Background="Transparent">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2"
              Padding="14"
              CornerRadius="12"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              Background="#FFFFFF">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel Visibility="{Binding IsConfigCategorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="配置设置"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
              <TextBlock Margin="0,8,0,0"
                         Text="{Binding ConfigIntroText}"
                         Foreground="#475569"
                         TextWrapping="Wrap" />

              <TextBlock Margin="0,14,0,0"
                         Text="配置文件（research-settings.json）"
                         FontWeight="SemiBold" />
              <Grid Margin="0,6,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         IsReadOnly="True"
                         Text="{Binding SettingsFilePath, Mode=OneWay}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Content="打开配置文件"
                        Command="{Binding OpenConfigFileCommand}" />
              </Grid>

              <TextBlock Text="默认输出地理数据库（.gdb）"
                         FontWeight="SemiBold" />
              <TextBox Margin="0,6,0,0"
                       Text="{Binding DefaultOutputGdb, UpdateSourceTrigger=PropertyChanged}" />

              <Border Margin="0,16,0,0"
                      Padding="12"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      CornerRadius="10"
                      Background="#F8FAFC">
                <StackPanel>
                  <TextBlock Text="前期调研 Key"
                             FontWeight="SemiBold"
                             Foreground="#0F172A" />
                  <TextBlock Margin="0,6,0,0"
                             Text="补充区由用户直接填写，运行时补充优先、基础兜底。基础区锁定时仅显示掩码。"
                             Foreground="#475569"
                             TextWrapping="Wrap" />

                  <Border Margin="0,12,0,0"
                          Padding="10"
                          CornerRadius="8"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          Background="#FFFFFF">
                    <StackPanel>
                      <TextBlock Text="百度 AK 补充区"
                                 FontWeight="SemiBold" />
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding SupplementalKeyHintText}"
                                 Foreground="#64748B"
                                 TextWrapping="Wrap" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding BaiduAkSupplementalText, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Margin="0,10,0,0"
                                 Text="百度 AK 基础区"
                                 FontWeight="SemiBold" />
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding BaseKeyHintText}"
                                 Foreground="#64748B"
                                 TextWrapping="Wrap" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding BaiduAkBaseText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                          <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="False" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanEditBaseKeys}" Value="False">
                                <Setter Property="IsReadOnly" Value="True" />
                                <Setter Property="Background" Value="#F8FAFC" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                    </StackPanel>
                  </Border>

                  <Border Margin="0,12,0,0"
                          Padding="10"
                          CornerRadius="8"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          Background="#FFFFFF">
                    <StackPanel>
                      <TextBlock Text="高德 Key 补充区"
                                 FontWeight="SemiBold" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding AmapKeySupplementalText, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Margin="0,10,0,0"
                                 Text="高德 Key 基础区"
                                 FontWeight="SemiBold" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding AmapKeyBaseText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                          <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="False" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanEditBaseKeys}" Value="False">
                                <Setter Property="IsReadOnly" Value="True" />
                                <Setter Property="Background" Value="#F8FAFC" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Margin="0,16,0,0"
                      Padding="12"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      CornerRadius="10"
                      Background="#F8FAFC">
                <StackPanel>
                  <TextBlock Text="在线瓦片服务密钥"
                             FontWeight="SemiBold"
                             Foreground="#0F172A" />
                  <TextBlock Margin="0,6,0,0"
                             Text="{Binding ImageryIntroText}"
                             Foreground="#475569"
                             TextWrapping="Wrap" />

                  <Grid Margin="0,10,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             Text="{Binding ImagerySettingsFilePath, Mode=OneWay}" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Content="打开影像配置文件"
                            Command="{Binding OpenImageryConfigFileCommand}" />
                  </Grid>

                  <Border Padding="10"
                          CornerRadius="8"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          Background="#FFFFFF">
                    <StackPanel>
                      <TextBlock Text="天地图密钥补充区"
                                 FontWeight="SemiBold" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding TianDiTuSupplementalKeysText, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Margin="0,10,0,0"
                                 Text="天地图密钥基础区"
                                 FontWeight="SemiBold" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding TianDiTuBaseKeysText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                          <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="False" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanEditBaseKeys}" Value="False">
                                <Setter Property="IsReadOnly" Value="True" />
                                <Setter Property="Background" Value="#F8FAFC" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>

                      <TextBlock Margin="0,12,0,0"
                                 Text="吉林一号密钥补充区"
                                 FontWeight="SemiBold" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding JilinApiSupplementalKeysText, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Margin="0,10,0,0"
                                 Text="吉林一号密钥基础区"
                                 FontWeight="SemiBold" />
                      <TextBox Margin="0,6,0,0"
                               Height="88"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"
                               Text="{Binding JilinApiBaseKeysText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                          <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="False" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanEditBaseKeys}" Value="False">
                                <Setter Property="IsReadOnly" Value="True" />
                                <Setter Property="Background" Value="#F8FAFC" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Margin="0,16,0,0"
                      Padding="12"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      CornerRadius="10"
                      Background="#FFFFFF">
                <StackPanel>
                  <TextBlock Text="管理员基础密钥"
                             FontWeight="SemiBold"
                             Foreground="#0F172A" />
                  <TextBlock Margin="0,6,0,0"
                             Text="{Binding BaseKeysStatusText}"
                             Foreground="#0F766E"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />

                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="AdminPasswordBox"
                                 Grid.Column="0"
                                 Height="30"
                                 PasswordChanged="AdminPasswordBox_OnPasswordChanged" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Content="{Binding AdminUnlockButtonText}"
                            Click="AdminUnlockButton_Click" />
                  </Grid>

                  <TextBlock Margin="0,8,0,0"
                             Text="{Binding AdminLockHintText}"
                             Foreground="#64748B"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding IsAppearanceCategorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="外观设置"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
              <TextBlock Margin="0,6,0,0"
                         Text="这些参数会同时影响主工作台和“面状要素转 TXT”窗口，调整后实时生效。"
                         Foreground="#64748B"
                         TextWrapping="Wrap" />

              <TextBlock Margin="0,12,0,0"
                         Text="界面密度（实时生效）"
                         FontWeight="SemiBold" />
              <Grid Margin="0,6,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0"
                        Minimum="80"
                        Maximum="120"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding UiDensityPercent, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding UiDensityPercentText}" />
              </Grid>

              <TextBlock Text="左侧工具栏宽度（实时生效）"
                         FontWeight="SemiBold" />
              <Grid Margin="0,6,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0"
                        Minimum="50"
                        Maximum="200"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding UiLeftPaneWidthPercent, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding UiLeftPaneWidthPercentText}" />
              </Grid>

              <TextBlock Text="右侧参数区最小宽度（实时生效）"
                         FontWeight="SemiBold" />
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0"
                        Minimum="50"
                        Maximum="200"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding UiRightPaneMinWidthPercent, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding UiRightPaneMinWidthPercentText}" />
              </Grid>
            </StackPanel>

            <StackPanel Visibility="{Binding IsSystemLogCategorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="系统日志"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />

              <TextBlock Margin="0,12,0,0"
                         Foreground="#475569"
                         Text="在这里打开系统日志窗口，查看模块日志和诊断日志路径。"
                         TextWrapping="Wrap" />

              <Button Margin="0,12,0,0"
                      Padding="12,6"
                      HorizontalAlignment="Left"
                      Content="打开系统日志窗口"
                      Command="{Binding OpenSystemLogWindowCommand}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="10"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Background="#FFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock VerticalAlignment="Center"
                   Foreground="#0F766E"
                   Text="{Binding StatusMessage}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Padding="12,6"
                  Margin="0,0,8,0"
                  Content="重新加载"
                  Command="{Binding ReloadCommand}" />
          <Button Padding="12,6"
                  Margin="0,0,8,0"
                  Content="保存设置"
                  Command="{Binding SaveCommand}" />
          <Button Padding="12,6"
                  Content="关闭"
                  Command="{Binding CloseCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
