<Window x:Class="GisProAddinWorkbench.AddIn.Info.VersionStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本与声明"
        Width="920"
        Height="760"
        MinWidth="820"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Padding="16"
                Background="#F8FBFF"
                BorderBrush="#C9DDF5"
                BorderThickness="1"
                CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1565C0"
                       Text="版本与声明" />
          </StackPanel>
        </Border>

        <UniformGrid Margin="0,16,0,0"
                     Columns="2">
          <Border Margin="0,0,8,8"
                  Padding="14"
                  Background="#FFFFFF"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="版本信息" />
              <TextBlock Margin="0,10,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding PluginName}" />
              <TextBlock Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding PublicVersionText}" />
              <TextBlock Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding AssemblyVersionText}" />
              <TextBlock Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding InformationalVersionText}" />
              <TextBlock Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding UpdatedAtText}" />
            </StackPanel>
          </Border>

          <Border Margin="8,0,0,8"
                  Padding="14"
                  Background="#FFFFFF"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="作者信息" />
              <TextBlock Margin="0,10,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding AuthorText}" />
            </StackPanel>
          </Border>

          <Border Margin="0,0,8,8"
                  Padding="14"
                  Background="#FFFFFF"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="软件介绍" />
              <TextBlock Margin="0,10,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding SoftwareIntroText}" />
            </StackPanel>
          </Border>

          <Border Margin="8,0,0,8"
                  Padding="14"
                  Background="#FFFFFF"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="借鉴创意与开源项目" />
              <TextBlock Margin="0,10,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding InspirationText}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Margin="0,0,8,0"
                  Padding="14"
                  Background="#FFFFFF"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="QQ群二维码" />
              <Border Margin="0,12,0,0"
                      Width="220"
                      Height="220"
                      HorizontalAlignment="Left"
                      Background="#F9FAFB"
                      BorderBrush="#D1D5DB"
                      BorderThickness="1"
                      CornerRadius="8">
                <Image Source="{Binding QqGroupQrImage}"
                       Stretch="Uniform" />
              </Border>
              <TextBlock Margin="0,8,0,0"
                         Foreground="#4B5563"
                         Text="{Binding QqGroupQrText}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="14"
                  Background="#FFFFFF"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="公众号二维码" />
              <Border Margin="0,12,0,0"
                      Width="220"
                      Height="220"
                      HorizontalAlignment="Left"
                      Background="#F9FAFB"
                      BorderBrush="#D1D5DB"
                      BorderThickness="1"
                      CornerRadius="8">
                <Image Source="{Binding WechatQrImage}"
                       Stretch="Uniform" />
              </Border>
              <TextBlock Margin="0,8,0,0"
                         Foreground="#4B5563"
                         Text="{Binding WechatQrText}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Margin="0,16,0,0"
                Padding="14"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
          <StackPanel>
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="诊断信息" />
            <TextBlock Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding DiagnosticsPathText}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1"
               Margin="0,14,0,0"
               LastChildFill="False">
      <Button MinWidth="108"
              Padding="14,6"
              Content="关闭"
              Click="OnCloseClick" />
    </DockPanel>
  </Grid>
</Window>
