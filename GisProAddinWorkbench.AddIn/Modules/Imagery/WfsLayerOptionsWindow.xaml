<Window x:Class="GisProAddinWorkbench.AddIn.Modules.Imagery.WfsLayerOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="&#x6DFB;&#x52A0; WFS &#x56FE;&#x5C42;"
        Width="760"
        Height="720"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
  <Window.Resources>
    <Style x:Key="SectionBorderStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="#FFF8FAFC" />
      <Setter Property="BorderBrush" Value="#FFCBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style x:Key="OptionComboStyle" TargetType="ComboBox">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="#FFF8FAFC" />
      <Setter Property="BorderBrush" Value="#FFCBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="12"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Background="#F8FAFC">
      <StackPanel>
        <TextBlock Text="&#x6DFB;&#x52A0; WFS &#x56FE;&#x5C42;"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#0F172A" />
        <TextBlock Margin="0,6,0,0"
                   Text="{Binding PresetTitle}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#2563EB" />
        <TextBlock Margin="0,4,0,0"
                   Text="{Binding PresetSummary}"
                   Foreground="#334155"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0"
                   Text="{Binding ServiceUrlText}"
                   Foreground="#64748B"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Margin="0,10,0,10"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource SectionBorderStyle}">
          <StackPanel>
            <TextBlock Text="&#x8FDE;&#x63A5;&#x8BBE;&#x7F6E;"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="&#x8FDE;&#x63A5;&#x6A21;&#x5F0F;" />
                <ComboBox Style="{StaticResource OptionComboStyle}"
                          ItemsSource="{Binding ConnectionModeOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedConnectionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#64748B"
                           Text="&#x5FEB;&#x7167;&#x4F1A;&#x5728;&#x672C;&#x5730;&#x7F13;&#x5B58;&#x8981;&#x7D20;&#xFF0C;&#x6309;&#x9700;&#x5219;&#x66F4;&#x63A5;&#x8FD1;&#x5728;&#x7EBF;&#x6D4F;&#x89C8;&#x3002;"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="&#x6700;&#x5927;&#x8981;&#x7D20;&#x6570;" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding MaxFeaturesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="&#x9875;&#x9762;&#x5927;&#x5C0F;" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding PageSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#64748B"
                           Text="&#x7559;&#x7A7A;&#x8868;&#x793A;&#x4F7F;&#x7528;&#x670D;&#x52A1;&#x9ED8;&#x8BA4;&#x503C;&#x3002;"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="&#x56FE;&#x5C42;&#x540D;&#x79F0;" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"
                         Text="{Binding LayerNameText, Mode=OneWay}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,10,0,0"
                Style="{StaticResource SectionBorderStyle}">
          <StackPanel>
            <TextBlock Text="&#x7A7A;&#x95F4;&#x8303;&#x56F4;"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />

            <CheckBox Margin="0,10,0,0"
                      Content="&#x4F7F;&#x7528;&#x7A7A;&#x95F4;&#x8303;&#x56F4;"
                      IsChecked="{Binding UseSpatialExtent, Mode=TwoWay}" />

            <StackPanel Margin="0,10,0,0"
                        IsEnabled="{Binding IsSpatialExtentEnabled}">
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabelStyle}"
                             Text="&#x4ece;&#x4ee5;&#x4e0b;&#x4f4d;&#x7f6e;&#x83b7;&#x53d6;&#x8303;&#x56f4;" />
                  <ComboBox Style="{StaticResource OptionComboStyle}"
                            ItemsSource="{Binding ExtentSourceOptions}"
                            DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedExtentSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsSpatialExtentEnabled}" />
                  <ComboBox Margin="0,8,0,0"
                            Style="{StaticResource OptionComboStyle}"
                            ItemsSource="{Binding ExtentLayerOptions}"
                            DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedExtentLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsLayerExtentEnabled}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0">
                  <TextBlock Style="{StaticResource FieldLabelStyle}"
                             Text="&#x6240;&#x9009;&#x8303;&#x56F4;" />
                  <TextBlock Foreground="#64748B"
                             Text="{Binding SelectedExtentText}"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,6,0,0"
                             Foreground="#64748B"
                             Text="{Binding DisplayUnitsText}" />
                </StackPanel>
              </Grid>

              <Border Padding="10"
                      CornerRadius="10"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      Background="#F8FAFC">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="&#x6700;&#x5C0F;&#x7ECF;&#x5EA6; / X" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             IsEnabled="{Binding IsSpatialExtentEnabled}"
                             Text="{Binding ExtentMinXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="&#x6700;&#x5C0F;&#x7EAC;&#x5EA6; / Y" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             IsEnabled="{Binding IsSpatialExtentEnabled}"
                             Text="{Binding ExtentMinYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Grid.Column="0"
                              Grid.Row="1"
                              Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="&#x6700;&#x5927;&#x7ECF;&#x5EA6; / X" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             IsEnabled="{Binding IsSpatialExtentEnabled}"
                             Text="{Binding ExtentMaxXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2"
                              Grid.Row="1"
                              Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="&#x6700;&#x5927;&#x7EAC;&#x5EA6; / Y" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             IsEnabled="{Binding IsSpatialExtentEnabled}"
                             Text="{Binding ExtentMaxYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <Expander Margin="0,10,0,0"
                  Padding="12"
                  BorderBrush="#E2E8F0"
                  BorderThickness="1"
                  Background="#FFFFFF"
                  Header="&#x9AD8;&#x7EA7;&#x53C2;&#x6570;"
                  IsExpanded="False">
          <StackPanel>
            <CheckBox Content="&#x4EA4;&#x6362; XY&#xFF08;SWAPXY&#xFF09;"
                      IsChecked="{Binding SwapXY, Mode=TwoWay}" />
            <CheckBox Margin="0,8,0,0"
                      Content="&#x4EA4;&#x6362; XY &#x8FC7;&#x6EE4;&#xFF08;SWAPXYFILTER&#xFF09;"
                      IsChecked="{Binding SwapXYFilter, Mode=TwoWay}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="10"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Background="#F8FAFC">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock VerticalAlignment="Center"
                   Foreground="#0F766E"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button Margin="0,0,10,0"
                  Padding="18,8"
                  Content="&#x786E;&#x5B9A;"
                  Command="{Binding ConfirmCommand}" />
          <Button Padding="18,8"
                  Content="&#x53D6;&#x6D88;"
                  Command="{Binding CancelCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
