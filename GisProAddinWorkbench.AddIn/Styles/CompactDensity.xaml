<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Typography scale -->
  <sys:Double x:Key="CompactFontTitle">18</sys:Double>
  <sys:Double x:Key="CompactFontSection">14</sys:Double>
  <sys:Double x:Key="CompactFontBody">11</sys:Double>
  <sys:Double x:Key="CompactFontCaption">10</sys:Double>

  <!-- Spacing scale -->
  <Thickness x:Key="CompactPaddingCard">12,10,12,10</Thickness>
  <Thickness x:Key="CompactPaddingButton">10,6,10,6</Thickness>
  <Thickness x:Key="CompactPaddingInput">6,3,6,3</Thickness>
  <Thickness x:Key="CompactMarginStack">0,10,0,0</Thickness>
  <Thickness x:Key="CompactMarginSection">0,12,0,0</Thickness>
  <Thickness x:Key="CompactMarginSmall">0,6,0,0</Thickness>

  <!-- Control sizes -->
  <sys:Double x:Key="CompactInputHeight">30</sys:Double>
  <sys:Double x:Key="CompactCornerRadius">12</sys:Double>
  <GridLength x:Key="CompactLeftPaneWidth">230</GridLength>
  <GridLength x:Key="CompactPaneGapWidth">12</GridLength>
  <sys:Double x:Key="CompactRightPaneMinWidth">520</sys:Double>
  <sys:Double x:Key="CompactFaceToTxtWindowWidth">1280</sys:Double>
  <sys:Double x:Key="CompactFaceToTxtWindowHeight">820</sys:Double>
  <sys:Double x:Key="CompactFaceToTxtMinWidth">980</sys:Double>
  <sys:Double x:Key="CompactFaceToTxtMinHeight">640</sys:Double>
  <GridLength x:Key="CompactFaceToTxtLeftPaneWidth">480</GridLength>
  <GridLength x:Key="CompactFaceToTxtPreviewRowHeight">280</GridLength>

  <Style x:Key="CompactInputTextBoxStyle" TargetType="TextBox">
    <Setter Property="Height" Value="{DynamicResource CompactInputHeight}" />
    <Setter Property="Padding" Value="{DynamicResource CompactPaddingInput}" />
    <Setter Property="FontSize" Value="{DynamicResource CompactFontBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="CompactInputComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Height" Value="{DynamicResource CompactInputHeight}" />
    <Setter Property="Padding" Value="{DynamicResource CompactPaddingInput}" />
    <Setter Property="FontSize" Value="{DynamicResource CompactFontBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="CompactActionButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="{DynamicResource CompactPaddingButton}" />
    <Setter Property="FontSize" Value="{DynamicResource CompactFontBody}" />
  </Style>
</ResourceDictionary>
