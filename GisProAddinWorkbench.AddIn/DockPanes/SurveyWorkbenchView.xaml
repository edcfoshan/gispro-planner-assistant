<UserControl x:Class="GisProAddinWorkbench.AddIn.DockPanes.SurveyWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1280"
             MinWidth="720"
             MinHeight="620">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="SurfaceBorderStyle" TargetType="Border">
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#FFFFFFFF" />
    </Style>

    <Style x:Key="SubtleBorderStyle" TargetType="Border">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="#E6EDF5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#F8FAFC" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="MinWidth" Value="156" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#1D4ED8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="MinWidth" Value="156" />
      <Setter Property="Foreground" Value="#1E293B" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ToolCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{DynamicResource CompactLeftPaneWidth}" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Style="{StaticResource SurfaceBorderStyle}"
            Background="#FCFDFE">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                     FontWeight="SemiBold"
                     Foreground="#2563EB"
                     Text="{Binding OverviewTitle}" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="{DynamicResource CompactFontSection}"
                     FontWeight="SemiBold"
                     Foreground="#0F172A"
                     Text="工具列表" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="{DynamicResource CompactFontBody}"
                     Foreground="#475569"
                     Text="先选工具，再打开 ArcGIS 工具。需要更多说明时，在右侧展开附加信息。"
                     TextWrapping="Wrap" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="0,16,0,0"
                 ItemsSource="{Binding ToolCollectionView}"
                 SelectedItem="{Binding SelectedTool}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,10,0,8"
                             FontSize="{DynamicResource CompactFontCaption}"
                             FontWeight="SemiBold"
                             Foreground="#64748B"
                             Text="{Binding Name}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="ToolCard"
                      Style="{StaticResource ToolCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Width="38"
                          Height="38"
                          CornerRadius="12"
                          Background="{Binding AccentHex}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource CompactFontCaption}"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding Badge}" />
                  </Border>

                  <StackPanel Grid.Column="1"
                              Margin="12,0,0,0">
                    <DockPanel LastChildFill="False">
                      <TextBlock FontSize="{DynamicResource CompactFontBody}"
                                 FontWeight="SemiBold"
                                 Foreground="#0F172A"
                                 Text="{Binding DisplayName}"
                                 TextWrapping="Wrap" />
                      <Border DockPanel.Dock="Right"
                              Margin="8,0,0,0"
                              Padding="7,2"
                              CornerRadius="10"
                              Background="#F8FAFC"
                              BorderBrush="#DCE4EF"
                              BorderThickness="1">
                        <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Text="{Binding StatusLabel}" />
                      </Border>
                    </DockPanel>

                    <TextBlock Margin="0,4,0,0"
                               FontSize="{DynamicResource CompactFontCaption}"
                               Foreground="#475569"
                               Text="{Binding Summary}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                  </StackPanel>
                </Grid>
              </Border>

              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                             Value="True">
                  <Setter TargetName="ToolCard" Property="Background" Value="#F6FAFF" />
                  <Setter TargetName="ToolCard" Property="BorderBrush" Value="#93C5FD" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource SurfaceBorderStyle}"
                Background="#F7FAFF">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                           FontWeight="SemiBold"
                           Foreground="#2563EB"
                           Text="当前工具" />
                <Border DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        CornerRadius="11"
                        Background="#EEF2FF"
                        BorderBrush="#C7D2FE"
                        BorderThickness="1">
                  <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                             FontWeight="SemiBold"
                             Foreground="#3730A3"
                             Text="{Binding CurrentToolStatusLabel}" />
                </Border>
              </DockPanel>

              <TextBlock Margin="0,8,0,0"
                         FontSize="{DynamicResource CompactFontTitle}"
                         FontWeight="SemiBold"
                         Foreground="#0F172A"
                         Text="{Binding CurrentToolTitle}" />

              <TextBlock Margin="0,8,0,0"
                         FontSize="{DynamicResource CompactFontBody}"
                         Foreground="#334155"
                         Text="{Binding CurrentToolSummary}"
                         TextWrapping="Wrap" />

              <TextBlock Margin="0,8,0,0"
                         FontSize="{DynamicResource CompactFontCaption}"
                         Foreground="#64748B"
                         Text="{Binding CurrentToolScenario, StringFormat=适用场景：{0}}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Right">
              <Button Style="{StaticResource PrimaryButtonStyle}"
                      Content="打开 ArcGIS 工具"
                      Command="{Binding OpenToolCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="{DynamicResource CompactMarginSection}"
                Style="{StaticResource SurfaceBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                         FontWeight="SemiBold"
                         Foreground="#64748B"
                         Text="执行状态" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="{DynamicResource CompactFontSection}"
                         FontWeight="SemiBold"
                         Foreground="#0F766E"
                         Text="{Binding UseToolStatusText}"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="{DynamicResource CompactFontBody}"
                         Foreground="#475569"
                         Text="{Binding CurrentToolPathStatus}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                         FontWeight="SemiBold"
                         Foreground="#64748B"
                         Text="工具路径" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="{DynamicResource CompactFontBody}"
                         Foreground="#334155"
                         Text="{Binding CurrentToolPathDisplay}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="{DynamicResource CompactMarginSection}"
                Style="{StaticResource SurfaceBorderStyle}"
                Padding="0">
          <Expander IsExpanded="False"
                    Background="Transparent"
                    BorderThickness="0">
            <Expander.Header>
              <DockPanel Margin="18,16,18,16"
                         LastChildFill="True">
                <StackPanel>
                  <TextBlock FontSize="{DynamicResource CompactFontSection}"
                             FontWeight="SemiBold"
                             Foreground="#0F172A"
                             Text="更多说明" />
                  <TextBlock Margin="0,4,0,0"
                             FontSize="{DynamicResource CompactFontCaption}"
                             Foreground="#64748B"
                             Text="展开后查看输入输出、参数、流程和工具图示。" />
                </StackPanel>
              </DockPanel>
            </Expander.Header>

            <DockPanel Margin="18,0,18,18"
                       LastChildFill="True">
              <Border DockPanel.Dock="Right"
                      Width="280"
                      Margin="18,0,0,0"
                      Style="{StaticResource SubtleBorderStyle}"
                      Visibility="{Binding HasCurrentIllustration, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                             FontWeight="SemiBold"
                             Foreground="#64748B"
                             Text="工具图示" />
                  <Border Margin="0,10,0,0"
                          Padding="6"
                          Background="#FFFFFF"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          CornerRadius="12">
                    <Image MaxHeight="240"
                           Stretch="Uniform"
                           Source="{Binding CurrentIllustrationPath}" />
                  </Border>
                </StackPanel>
              </Border>

              <StackPanel>
                <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Text="输入 / 输出" />

                <Border Margin="0,10,0,0"
                        Style="{StaticResource SubtleBorderStyle}">
                  <StackPanel>
                    <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Text="典型输入" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="{DynamicResource CompactFontBody}"
                               Foreground="#334155"
                               Text="{Binding CurrentToolInputs}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{StaticResource SubtleBorderStyle}">
                  <StackPanel>
                    <TextBlock FontSize="{DynamicResource CompactFontCaption}"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Text="典型输出" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="{DynamicResource CompactFontBody}"
                               Foreground="#334155"
                               Text="{Binding CurrentToolOutputs}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,0"
                           FontSize="{DynamicResource CompactFontCaption}"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Text="关键参数" />
                <Border Margin="0,10,0,0"
                        Style="{StaticResource SubtleBorderStyle}">
                  <TextBlock FontSize="{DynamicResource CompactFontBody}"
                             Foreground="#334155"
                             Text="{Binding CurrentToolParameters}"
                             TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,16,0,0"
                           FontSize="{DynamicResource CompactFontCaption}"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Text="使用提示" />
                <Border Margin="0,10,0,0"
                        Style="{StaticResource SubtleBorderStyle}">
                  <TextBlock FontSize="{DynamicResource CompactFontBody}"
                             Foreground="#334155"
                             Text="{Binding CurrentToolNotes}"
                             TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,16,0,0"
                           FontSize="{DynamicResource CompactFontCaption}"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Text="建议流程" />
                <ItemsControl Margin="0,10,0,0"
                              ItemsSource="{Binding CurrentFlowSteps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,10"
                              Style="{StaticResource SubtleBorderStyle}">
                        <DockPanel>
                          <Border Width="24"
                                  Height="24"
                                  Margin="0,0,10,0"
                                  CornerRadius="12"
                                  Background="#DBEAFE">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource CompactFontCaption}"
                                       FontWeight="Bold"
                                       Foreground="#1D4ED8"
                                       Text="步" />
                          </Border>
                          <TextBlock VerticalAlignment="Center"
                                     FontSize="{DynamicResource CompactFontBody}"
                                     Foreground="#334155"
                                     Text="{Binding}"
                                     TextWrapping="Wrap" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
